{
  "$schema": "https://biomejs.dev/schemas/2.6.4/schema.json",
  "files": {
    "includes": [
      "**",
      "!!worker-configuration.d.ts",
      "!!PLAN.md",
      "!!.cache",
      "!!package-lock.json"
    ]
  },
  "formatter": { "indentStyle": "space", "lineWidth": 100 },
  "linter": { "enabled": true, "rules": { "preset": "none" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
